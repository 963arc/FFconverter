#!/bin/bash
set -e

# Install Python dependencies
pip3 install --break-system-packages customtkinter send2trash tkinterdnd2 || true

# Create launcher script if it doesn't exist
if [ ! -f /usr/bin/FFConverter ]; then
    echo '#!/bin/bash' > /usr/bin/FFConverter
    echo 'python3 /usr/share/ffconverter/ffc.py "$@"' >> /usr/bin/FFConverter
    chmod +x /usr/bin/FFConverter
fi

exit 0